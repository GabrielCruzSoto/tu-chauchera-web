# ─── Tu Chauchera — Environment Variables ────────────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create a Google Cloud project and OAuth 2.0 client credentials at:
# https://console.cloud.google.com/apis/credentials
# Add your development URL (e.g., http://localhost:5173) as an authorized origin.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Support & Feedback ────────────────────────────────────────────────────────
VITE_SUPPORT_EMAIL=tuchaucheracl@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: No VITE_APP_SALT is needed.
# The AES-256-GCM encryption key is derived from the user's master password
# using PBKDF2. The password is the secret — not an app-level salt.
# See: src/shared/utils/crypto.ts
# ─────────────────────────────────────────────────────────────────────────────
